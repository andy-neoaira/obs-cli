{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andy-neoaira/obs-cli/docs/spec/schema/agent-result-v1.schema.json",
  "title": "miniobsidian Agent result v1",
  "type": "object",
  "required": ["schema_version", "request_id", "status", "summary", "changes", "errors"],
  "properties": {
    "schema_version": {"const": "miniobsidian.agent-result/v1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "status": {"enum": ["success", "partial", "failed", "cancelled", "conflict"]},
    "summary": {"type": "string"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "revision_before", "revision_after", "summary"],
        "properties": {
          "path": {"type": "string", "pattern": "\\.md$"},
          "revision_before": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "revision_after": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "summary": {"type": "string"},
          "before_content": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "recovery_steps"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "\\.md$"},
          "recovery_steps": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "cancelled"}}},
      "then": {
        "properties": {
          "changes": {"maxItems": 0},
          "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["partial", "failed", "conflict"]}}},
      "then": {
        "properties": {
          "errors": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
