{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andy-neoaira/obs-cli/docs/spec/schema/project-status-report-v2.schema.json",
  "type": "object",
  "required": ["status", "vault", "project", "period_id", "window", "baseline", "sources", "evidence", "progress", "risks", "decisions", "next_steps", "writeback", "writeback_plan", "verified", "warnings", "errors"],
  "properties": {
    "status": {"enum": ["success", "no_change", "stale", "conflict", "partial", "failed"]},
    "vault": {"type": "string", "minLength": 1},
    "project": {"type": "string", "pattern": "\\.md$"},
    "period_id": {"type": "string", "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"},
    "window": {
      "type": "object",
      "required": ["timezone", "start", "end", "inclusive"],
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "inclusive": {"const": true}
      },
      "additionalProperties": false
    },
    "baseline": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["period_id", "path", "revision", "section", "evidence_id"],
          "properties": {
            "period_id": {"type": "string", "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$"},
            "path": {"type": "string"},
            "revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "section": {"type": "string"},
            "evidence_id": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "progress": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "next_steps": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "writeback": {
      "type": "object",
      "required": ["requested", "status", "revision_before", "revision_after"],
      "properties": {
        "requested": {"type": "boolean"},
        "status": {"enum": ["not_requested", "planned", "applied", "no_change", "conflict", "failed"]},
        "revision_before": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "revision_after": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
      },
      "additionalProperties": false
    },
    "writeback_plan": {
      "type": "object",
      "required": ["section", "payload_digest", "expected_digest", "planned_revision_after", "request_id", "sources_verified_at"],
      "properties": {
        "section": {"const": "Status"},
        "payload_digest": {"type": "string"},
        "expected_digest": {"type": "string"},
        "planned_revision_after": {"type": "string"},
        "request_id": {"type": "string"},
        "sources_verified_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verified": {
      "type": "object",
      "required": ["period_heading_count", "payload_count", "sources_current"],
      "properties": {
        "period_heading_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "payload_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "sources_current": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object"}}
  },
  "allOf": [
    {
      "if": {"properties": {"writeback": {"properties": {"requested": {"const": false}}}}},
      "then": {
        "properties": {
          "writeback": {
            "properties": {
              "status": {"const": "not_requested"},
              "revision_before": {"const": ""},
              "revision_after": {"const": ""}
            }
          },
          "writeback_plan": {
            "properties": {
              "payload_digest": {"const": ""},
              "expected_digest": {"const": ""},
              "planned_revision_after": {"const": ""},
              "request_id": {"const": ""},
              "sources_verified_at": {"const": ""}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"writeback": {"properties": {"requested": {"const": true}}}}},
      "then": {
        "properties": {
          "writeback": {"properties": {"status": {"enum": ["planned", "applied", "no_change", "conflict", "failed"]}}},
          "writeback_plan": {
            "properties": {
              "payload_digest": {"pattern": "^sha256:[a-f0-9]{64}$"},
              "request_id": {"minLength": 1},
              "sources_verified_at": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"writeback": {"properties": {"status": {"enum": ["planned", "applied", "no_change"]}}}}},
      "then": {
        "properties": {
          "writeback": {
            "properties": {
              "revision_before": {"pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "writeback_plan": {
            "properties": {
              "expected_digest": {"pattern": "^sha256:[a-f0-9]{64}$"},
              "planned_revision_after": {"pattern": "^sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"writeback": {"properties": {"status": {"enum": ["applied", "no_change"]}}}}},
      "then": {
        "properties": {
          "writeback": {
            "properties": {
              "revision_after": {"pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "verified": {
            "properties": {
              "period_heading_count": {"const": 1},
              "payload_count": {"const": 1},
              "sources_current": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"writeback": {"properties": {"status": {"const": "no_change"}}}}},
      "then": {"properties": {"status": {"const": "no_change"}}}
    },
    {
      "if": {"properties": {"writeback": {"properties": {"status": {"const": "conflict"}}}}},
      "then": {
        "properties": {
          "status": {"const": "conflict"},
          "writeback": {
            "properties": {
              "revision_before": {"pattern": "^sha256:[a-f0-9]{64}$"},
              "revision_after": {"const": ""}
            }
          },
          "verified": {
            "properties": {
              "period_heading_count": {"const": 1},
              "payload_count": {"const": 0},
              "sources_current": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "role", "path", "revision", "date", "query", "scope", "selection_reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[1-9][0-9]*$"}, "role": {"enum": ["project", "daily", "task"]},
        "path": {"type": "string"}, "revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "date": {"type": "string"}, "query": {"type": "string"},
        "scope": {"type": "string"}, "selection_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "source_id", "path", "revision", "location", "excerpt"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[1-9][0-9]*$"}, "source_id": {"type": "string", "pattern": "^S[1-9][0-9]*$"},
        "path": {"type": "string"}, "revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "location": {"type": "string"}, "excerpt": {"type": "string"}
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "category", "statement", "epistemic_status", "evidence_ids"],
      "properties": {
        "id": {"type": "string"},
        "category": {"enum": ["progress", "risk", "decision", "next_step"]},
        "statement": {"type": "string"},
        "epistemic_status": {"enum": ["source_statement", "inference", "unknown"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"epistemic_status": {"enum": ["source_statement", "inference"]}}},
          "then": {"properties": {"evidence_ids": {"minItems": 1}}}
        }
      ]
    }
  },
  "additionalProperties": false
}
