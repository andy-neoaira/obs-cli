        {"id": "compare-non-trigger", "kind": "non_trigger", "prompt": "综合多篇资料并写成新笔记", "expected": {"selected": false, "outcome": "not_selected", "operations": [], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "compare-success", "kind": "success", "prompt": "比较两篇明确笔记并保留证据", "expected": {"selected": true, "outcome": "success", "operations": ["note.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
