        {"id": "daily-success", "kind": "success", "prompt": "追加一段多行日志到今天的 Daily", "expected": {"selected": true, "outcome": "success", "operations": ["daily.get", "daily.append"], "writes": ["daily:<resolved>"], "vault_unchanged": false, "silent_overwrite": false}},
