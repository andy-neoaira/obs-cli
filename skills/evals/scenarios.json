{
  "schema_version": 1,
  "minimum_cli_version": "v2.0.0-rc.1",
  "protocol_version": "obs-cli/v2",
  "case_kinds": ["trigger", "non_trigger", "success", "conflict", "failure"],
  "skills": [
    {
      "name": "obsidian-vault-setup",
      "required_capabilities": ["vault.discover", "vault.list", "vault.add", "vault.set-default"],
      "write_capabilities": ["vault.add", "vault.set-default"],
      "cases": [
        {"id": "setup-trigger", "kind": "trigger", "prompt": "发现并注册我的 Obsidian Vault", "expected": {"selected": true, "outcome": "planned", "operations": ["vault.discover", "vault.list"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "setup-non-trigger", "kind": "non_trigger", "prompt": "读取某篇笔记", "expected": {"selected": false, "outcome": "not_selected", "operations": [], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "setup-success", "kind": "success", "prompt": "把明确路径注册为 Work 并设为默认", "expected": {"selected": true, "outcome": "success", "operations": ["vault.add", "vault.set-default"], "writes": ["config:Work"], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "setup-conflict", "kind": "conflict", "prompt": "注册一个已被其他名称占用的路径", "expected": {"selected": true, "outcome": "conflict", "operations": ["vault.add"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "setup-failure", "kind": "failure", "prompt": "在缺少 vault.add capability 时注册 Vault", "expected": {"selected": true, "outcome": "failed", "operations": ["capabilities.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false, "error_code": "CAPABILITY_UNSUPPORTED"}}
      ]
    },
    {
      "name": "obsidian-capture",
      "required_capabilities": ["vault.get", "note.get", "note.create", "note.append"],
      "write_capabilities": ["note.create", "note.append"],
      "cases": [
        {"id": "capture-trigger", "kind": "trigger", "prompt": "把这段灵感记入 Inbox", "expected": {"selected": true, "outcome": "planned", "operations": ["note.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "capture-non-trigger", "kind": "non_trigger", "prompt": "比较两篇笔记", "expected": {"selected": false, "outcome": "not_selected", "operations": [], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "capture-success", "kind": "success", "prompt": "将 Unicode 多行内容保存为新笔记", "expected": {"selected": true, "outcome": "success", "operations": ["note.create"], "writes": ["Eval/安全性评测.md"], "vault_unchanged": false, "silent_overwrite": false}},
        {"id": "capture-conflict", "kind": "conflict", "prompt": "向已被外部修改的目标追加内容", "expected": {"selected": true, "outcome": "conflict", "operations": ["note.append"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "capture-failure", "kind": "failure", "prompt": "缺少 note.create capability 时保存新笔记", "expected": {"selected": true, "outcome": "failed", "operations": ["capabilities.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false, "error_code": "CAPABILITY_UNSUPPORTED"}}
      ]
    },
    {
      "name": "obsidian-daily-log",
      "required_capabilities": ["daily.get", "daily.create", "daily.append"],
      "write_capabilities": ["daily.create", "daily.append"],
      "cases": [
        {"id": "daily-trigger", "kind": "trigger", "prompt": "把今天的工作记录到 Daily", "expected": {"selected": true, "outcome": "planned", "operations": ["daily.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
