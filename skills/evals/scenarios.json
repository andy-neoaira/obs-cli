        {"id": "project-conflict", "kind": "conflict", "prompt": "metadata 计划后项目笔记被 Obsidian 修改", "expected": {"selected": true, "outcome": "conflict", "operations": ["metadata.set"], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "project-failure", "kind": "failure", "prompt": "缺少 metadata.set 时设置项目字段", "expected": {"selected": true, "outcome": "failed", "operations": ["capabilities.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false, "error_code": "CAPABILITY_UNSUPPORTED"}}
      ]
    },
    {
