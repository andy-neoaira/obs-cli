        {"id": "search-non-trigger", "kind": "non_trigger", "prompt": "把内容写入 Inbox", "expected": {"selected": false, "outcome": "not_selected", "operations": [], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
