        {"id": "daily-failure", "kind": "failure", "prompt": "Daily format 配置非法且无法解析目标", "expected": {"selected": true, "outcome": "failed", "operations": ["daily.get"], "writes": [], "vault_unchanged": true, "silent_overwrite": false, "error_code": "INVALID_ARGUMENT"}}
      ]
    },
