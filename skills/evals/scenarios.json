        {"id": "triage-non-trigger", "kind": "non_trigger", "prompt": "搜索项目资料但不要整理", "expected": {"selected": false, "outcome": "not_selected", "operations": [], "writes": [], "vault_unchanged": true, "silent_overwrite": false}},
        {"id": "triage-success", "kind": "success", "prompt": "确认把 Inbox/item 移到 Projects/item 并设置 type", "expected": {"selected": true, "outcome": "success", "operations": ["note.move", "metadata.set"], "writes": ["Projects/item.md"], "vault_unchanged": false, "silent_overwrite": false}},
