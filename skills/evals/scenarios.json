  "cross_cutting": [
    {
      "id": "dangerous-unicode-multiline",
      "fixture": "fixtures/dangerous-unicode.md",
      "plan": ["note.create --content-file <fixture> --dry-run", "note.create --content-file <fixture>"],
      "final_state": {"path": "Eval/安全性评测.md", "content": "exact_fixture_bytes"}
    },
    {
      "id": "stale-revision-preserves-vault",
